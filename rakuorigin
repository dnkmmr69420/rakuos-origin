#!/usr/bin/env bash
# rakuorigin — classify paths/commands/packages as base or user on Rakuos
set -euo pipefail

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------
OVERLAY_UPPER="/var/lib/rakuos/overlay/upper"
BASE_TOML="/var/lib/rakuos/image-packages.toml"
USR_ROOT="/usr"

# ---------------------------------------------------------------------------
# Globals set by flag parsing
# ---------------------------------------------------------------------------
OUTPUT_ONLY=false
PACKAGE_MODE=false
EXIT_STATUS=0

# Associative array of base packages (name.arch → 1). Populated once.
declare -A BASE_PKGS=()
BASE_PKGS_LOADED=false

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
usage() {
    cat <<EOF
Usage: rakuorigin [OPTIONS] <path|command|package> [more ...]

Classify whether files, commands or packages belong to the base image
or were installed by the user (overlay).

Options:
  -o    Minimal output: only "base", "user", "subdirectory", "external" or "error"
  -P    Treat every argument as a package name (with or without architecture suffix)

Examples:
  rakuorigin bash
  rakuorigin htop firefox /usr/share/applications
  rakuorigin -o /bin/echo
  rakuorigin -P htop btop firefox brave-browser
  rakuorigin -P -o 7zip 7zip.x86_64
EOF
    exit 1
}

# Print an error for the current item. Does NOT exit (so multiple args can be processed).
report_error() {
    EXIT_STATUS=1
    if $OUTPUT_ONLY; then
        printf 'error\n'
    else
        printf 'error: %s\n' "$*" >&2
    fi
}

# Return 0 if $1 is under /usr but NOT under /usr/local
is_allowed_usr_path() {
    local resolved="$1"
    case "$resolved" in
        "$USR_ROOT"/local/*|"$USR_ROOT"/local)
            return 1
            ;;
        "$USR_ROOT"/*|"$USR_ROOT")
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

# Given a resolved absolute path under /usr, return "user" or "base"
classify_path() {
    local abs="$1"
    local rel="${abs#"$USR_ROOT"}"
    rel="${rel#/}"

    if [[ -e "${OVERLAY_UPPER}/${rel}" ]] || [[ -L "${OVERLAY_UPPER}/${rel}" ]]; then
        printf 'user'
    else
        printf 'base'
    fi
}

# Load image-packages.toml into the BASE_PKGS associative array (once).
load_base_packages() {
    if $BASE_PKGS_LOADED; then
        return 0
    fi
    if [[ ! -f "$BASE_TOML" ]]; then
        report_error "base package list not found: $BASE_TOML"
        return 1
    fi

    local name
    while IFS= read -r name; do
        [[ -n "$name" ]] || continue
        BASE_PKGS["$name"]=1
    done < <(sed -n 's/^[[:space:]]*"\([^"]*\)".*=.*/\1/p' "$BASE_TOML")

    BASE_PKGS_LOADED=true
    return 0
}

# Return 0 if the given name.arch (or bare name with common arches) is in the base list.
is_base_package() {
    local input="$1"

    # Exact match
    if [[ -v BASE_PKGS["$input"] ]]; then
        return 0
    fi

    # Try appending common architectures
    local arch
    for arch in x86_64 aarch64 noarch i686; do
        if [[ -v BASE_PKGS["${input}.${arch}"] ]]; then
            return 0
        fi
    done

    # If input already has an arch suffix, try the bare name + other arches
    local bare="${input%.*}"
    if [[ "$bare" != "$input" ]]; then
        if [[ -v BASE_PKGS["$bare"] ]]; then
            return 0
        fi
        for arch in x86_64 aarch64 noarch i686; do
            if [[ -v BASE_PKGS["${bare}.${arch}"] ]]; then
                return 0
            fi
        done
    fi

    return 1
}

# Classify a package. Prints "base" or "user". Returns 0 on success, 1 if not found.
classify_package() {
    local pkg="$1"

    # First check whether it is a known base package (name or name.arch)
    if is_base_package "$pkg"; then
        printf 'base'
        return 0
    fi

    # Not in the image list — see if rpm knows it at all (user-installed)
    # Try the name as-is and also the bare name without arch
    if rpm -q "$pkg" &>/dev/null; then
        printf 'user'
        return 0
    fi

    local bare="${pkg%.*}"
    if [[ "$bare" != "$pkg" ]] && rpm -q "$bare" &>/dev/null; then
        printf 'user'
        return 0
    fi

    # Also try name.arch forms that rpm sometimes accepts
    local arch
    for arch in x86_64 aarch64 noarch i686; do
        if rpm -q "${pkg}.${arch}" &>/dev/null; then
            printf 'user'
            return 0
        fi
    done

    return 1
}

# Process a single package argument
process_package() {
    local pkg="$1"
    local result

    if result=$(classify_package "$pkg"); then
        if $OUTPUT_ONLY; then
            printf '%s\n' "$result"
        else
            printf '%s: %s\n' "$pkg" "$result"
        fi
    else
        report_error "package not found: $pkg"
    fi
}

# Process a single path or command argument
process_path_or_command() {
    local target="$1"
    local resolved=""

    # 1. Resolve to absolute path
    if [[ "$target" == /* ]]; then
        if [[ ! -e "$target" && ! -L "$target" ]]; then
            report_error "path does not exist: $target"
            return
        fi
        resolved=$(realpath -m "$target" 2>/dev/null || readlink -f "$target" 2>/dev/null || printf '%s' "$target")
    else
        # Command name – look up in PATH
        if command -v "$target" &>/dev/null; then
            resolved=$(command -v "$target")
            resolved=$(realpath -m "$resolved" 2>/dev/null || readlink -f "$resolved" 2>/dev/null || printf '%s' "$resolved")
        else
            report_error "command \"$target\" does not exist (not found in PATH)"
            return
        fi
    fi

    # 2. Enforce /usr restriction (allow /bin, /sbin etc. that resolve into /usr)
    if ! is_allowed_usr_path "$resolved"; then
        # Found in PATH but outside /usr → external
        if [[ "$target" != /* ]] && command -v "$target" &>/dev/null; then
            if $OUTPUT_ONLY; then
                printf 'external\n'
            else
                printf '%s → %s (not under /usr — external)\n' "$target" "$resolved"
            fi
            return
        fi
        report_error "path is not under /usr (or is under /usr/local): $resolved"
        return
    fi

    # 3. Directory handling
    if [[ -d "$resolved" ]]; then
        while IFS= read -r -d '' entry; do
            local tag
            if [[ -d "$entry" ]]; then
                tag="subdirectory"
            else
                tag=$(classify_path "$entry")
            fi

            if $OUTPUT_ONLY; then
                printf '%s\n' "$tag"
            else
                printf '%s  %s\n' "$entry" "$tag"
            fi
        done < <(find "$resolved" -mindepth 1 -maxdepth 1 -print0 | sort -z)
        return
    fi

    # 4. Ordinary file / symlink
    local tag
    tag=$(classify_path "$resolved")

    if $OUTPUT_ONLY; then
        printf '%s\n' "$tag"
    else
        printf '%s → %s (%s)\n' "$target" "$resolved" "$tag"
    fi
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
while getopts ':oP' opt; do
    case "$opt" in
        o) OUTPUT_ONLY=true ;;
        P) PACKAGE_MODE=true ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))

[[ $# -ge 1 ]] || usage

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
if $PACKAGE_MODE; then
    load_base_packages || true
fi

for TARGET in "$@"; do
    if $PACKAGE_MODE; then
        process_package "$TARGET"
    else
        process_path_or_command "$TARGET"
    fi
done

exit "$EXIT_STATUS"
