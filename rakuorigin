#!/usr/bin/env bash
# rakuorigin — classify paths/commands/packages as base or user on Rakuos
set -euo pipefail

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------
OVERLAY_UPPER="/var/lib/rakuos/overlay/upper"
BASE_TOML="/var/lib/rakuos/image-packages.toml"
USR_ROOT="/usr"

# ---------------------------------------------------------------------------
# Globals set by flag parsing
# ---------------------------------------------------------------------------
OUTPUT_ONLY=false
PACKAGE_MODE=false
EXIT_STATUS=0

# Cached base package list (populated on first use)
BASE_PKG_CACHE=""

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
usage() {
    cat <<EOF
Usage: rakuorigin [OPTIONS] <path|command|package> [more ...]

Classify whether files, commands or packages belong to the base image
or were installed by the user (overlay).

Options:
  -o    Minimal output: only "base", "user", "subdirectory", "external" or "error"
  -P    Treat every argument as a package name (with or without architecture suffix)

Examples:
  rakuorigin bash
  rakuorigin htop firefox /usr/share/applications
  rakuorigin -o /bin/echo
  rakuorigin -P htop btop firefox brave-browser
  rakuorigin -P -o 7zip 7zip.x86_64
EOF
    exit 1
}

# Print an error for the current item. Does NOT exit (so multiple args can be processed).
# Sets EXIT_STATUS=1.
report_error() {
    EXIT_STATUS=1
    if $OUTPUT_ONLY; then
        printf 'error\n'
    else
        printf 'error: %s\n' "$*" >&2
    fi
}

# Return 0 if $1 is under /usr but NOT under /usr/local
is_allowed_usr_path() {
    local resolved="$1"
    case "$resolved" in
        "$USR_ROOT"/local/*|"$USR_ROOT"/local)
            return 1
            ;;
        "$USR_ROOT"/*|"$USR_ROOT")
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

# Given a resolved absolute path under /usr, return "user" or "base"
classify_path() {
    local abs="$1"
    local rel="${abs#"$USR_ROOT"}"
    rel="${rel#/}"

    if [[ -e "${OVERLAY_UPPER}/${rel}" ]] || [[ -L "${OVERLAY_UPPER}/${rel}" ]]; then
        printf 'user'
    else
        printf 'base'
    fi
}

# Load (and cache) bare package names from image-packages.toml
# Handles lines like: "7zip.x86_64" = {reason = "Dependency"}
load_base_packages() {
    if [[ -n "$BASE_PKG_CACHE" ]]; then
        printf '%s' "$BASE_PKG_CACHE"
        return
    fi
    if [[ ! -f "$BASE_TOML" ]]; then
        report_error "base package list not found: $BASE_TOML"
        return 1
    fi
    BASE_PKG_CACHE=$(grep -oE '"[^"]+"\s*=' "$BASE_TOML" 2>/dev/null \
        | sed 's/^"//;s/"\s*=$//' \
        | sort -u)
    printf '%s' "$BASE_PKG_CACHE"
}

# Normalize a package name: accept both "foo" and "foo.x86_64"
# Prints the matching name or empty string. Exit status 0 always.
normalize_pkg() {
    local input="$1"
    local base_list
    base_list=$(load_base_packages) || true

    # Exact match first
    if printf '%s\n' "$base_list" | grep -qxF "$input"; then
        printf '%s' "$input"
        return
    fi

    # Try with common arches appended
    local arch
    for arch in x86_64 aarch64 noarch i686; do
        if printf '%s\n' "$base_list" | grep -qxF "${input}.${arch}"; then
            printf '%s' "${input}.${arch}"
            return
        fi
    done

    # Try stripping an existing arch suffix and re-matching
    local bare="${input%.*}"
    if [[ "$bare" != "$input" ]]; then
        if printf '%s\n' "$base_list" | grep -qxF "$bare"; then
            printf '%s' "$bare"
            return
        fi
        for arch in x86_64 aarch64 noarch i686; do
            if printf '%s\n' "$base_list" | grep -qxF "${bare}.${arch}"; then
                printf '%s' "${bare}.${arch}"
                return
            fi
        done
    fi

    # Fallback: see if rpm knows it (may be a pure user package)
    if rpm -q "$input" &>/dev/null; then
        printf '%s' "$input"
        return
    fi
    if [[ "$bare" != "$input" ]] && rpm -q "$bare" &>/dev/null; then
        printf '%s' "$bare"
        return
    fi

    printf ''
}

# Classify a package. Prints "base", "user", or nothing on failure.
# Returns 0 on success, 1 on failure (caller should report_error).
classify_package() {
    local pkg="$1"
    local normalized
    normalized=$(normalize_pkg "$pkg")

    if [[ -z "$normalized" ]]; then
        return 1
    fi

    local base_list
    base_list=$(load_base_packages) || true

    if printf '%s\n' "$base_list" | grep -qxF "$normalized"; then
        printf 'base'
        return 0
    fi

    if rpm -q "$normalized" &>/dev/null; then
        printf 'user'
        return 0
    fi

    return 1
}

# Process a single package argument
process_package() {
    local pkg="$1"
    local result

    if result=$(classify_package "$pkg"); then
        if $OUTPUT_ONLY; then
            printf '%s\n' "$result"
        else
            printf '%s: %s\n' "$pkg" "$result"
        fi
    else
        report_error "package not found: $pkg"
    fi
}

# Process a single path or command argument
process_path_or_command() {
    local target="$1"
    local resolved=""

    # 1. Resolve to absolute path
    if [[ "$target" == /* ]]; then
        if [[ ! -e "$target" && ! -L "$target" ]]; then
            report_error "path does not exist: $target"
            return
        fi
        resolved=$(realpath -m "$target" 2>/dev/null || readlink -f "$target" 2>/dev/null || printf '%s' "$target")
    else
        # Command name – look up in PATH
        if command -v "$target" &>/dev/null; then
            resolved=$(command -v "$target")
            resolved=$(realpath -m "$resolved" 2>/dev/null || readlink -f "$resolved" 2>/dev/null || printf '%s' "$resolved")
        else
            report_error "command \"$target\" does not exist (not found in PATH)"
            return
        fi
    fi

    # 2. Enforce /usr restriction (allow /bin, /sbin etc. that resolve into /usr)
    if ! is_allowed_usr_path "$resolved"; then
        # Found in PATH but outside /usr → external
        if [[ "$target" != /* ]] && command -v "$target" &>/dev/null; then
            if $OUTPUT_ONLY; then
                printf 'external\n'
            else
                printf '%s → %s (not under /usr — external)\n' "$target" "$resolved"
            fi
            return
        fi
        report_error "path is not under /usr (or is under /usr/local): $resolved"
        return
    fi

    # 3. Directory handling
    if [[ -d "$resolved" ]]; then
        while IFS= read -r -d '' entry; do
            local tag
            if [[ -d "$entry" ]]; then
                tag="subdirectory"
            else
                tag=$(classify_path "$entry")
            fi

            if $OUTPUT_ONLY; then
                printf '%s\n' "$tag"
            else
                printf '%s  %s\n' "$entry" "$tag"
            fi
        done < <(find "$resolved" -mindepth 1 -maxdepth 1 -print0 | sort -z)
        return
    fi

    # 4. Ordinary file / symlink
    local tag
    tag=$(classify_path "$resolved")

    if $OUTPUT_ONLY; then
        printf '%s\n' "$tag"
    else
        printf '%s → %s (%s)\n' "$target" "$resolved" "$tag"
    fi
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
while getopts ':oP' opt; do
    case "$opt" in
        o) OUTPUT_ONLY=true ;;
        P) PACKAGE_MODE=true ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))

[[ $# -ge 1 ]] || usage

# ---------------------------------------------------------------------------
# Main loop – process every remaining argument
# ---------------------------------------------------------------------------
for TARGET in "$@"; do
    if $PACKAGE_MODE; then
        process_package "$TARGET"
    else
        process_path_or_command "$TARGET"
    fi
done

exit "$EXIT_STATUS"
